{
  "manifest_version": 3,
  "name": "拼图助手",
  "version": "1.1",
  "description": "检测到目标网址时自动启动拼图程序",
  "permissions": ["tabs", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon16.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png"
  }
}
